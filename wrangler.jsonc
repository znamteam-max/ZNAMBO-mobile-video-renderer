{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "znambo-mobile-video-renderer",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "znambo-mobile-video-renderer-media"
    }
  ]
}
